RewriteEngine On

# Ne pas afficher le contenu des répertoires sans page d'accueil.
Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Pages de test sans contenu utile : retrait définitif.
# Ces règles s'appliquent même si les anciens fichiers existent encore sur IONOS.
RewriteRule ^(?:Test|test-deploiement)(?:/index\.html|/|\.html)?$ - [G,L,NC]
RewriteCond %{THE_REQUEST} \s/+contact(?:/index\.html|\.html)(?:[?\s]) [NC]
RewriteRule ^contact(?:/index\.html|\.html)$ /contact/ [R=301,L,NE,NC]

# Anciennes adresses : conserver les liens vers leur équivalent actuel.
RewriteRule ^about(?:/index\.html|/|\.html)?$ /a-propos/ [R=301,L,NE]
RewriteRule ^photobooth(?:/index\.html|/|\.html)?$ /prestations/photobooth/ [R=301,L,NE]
RewriteRule ^evenement/mariage(?:/index\.html|/|\.html)?$ /evenements/mariages/ [R=301,L,NE]
RewriteRule ^option/phonebooth(?:/index\.html|/|\.html)?$ /options/phonebooth/ [R=301,L,NE]
RewriteRule ^prestation/360booth(?:/index\.html|/|\.html)?$ /prestations/videobooth/ [R=301,L,NE]
RewriteRule ^prestation/(air360booth|ipadbooth|miroirbooth|packvip|photobooth|voguebooth)(?:/index\.html|/|\.html)?$ /prestations/$1/ [R=301,L,NE]

# Ancienne page retirée : préserver les liens vers les solutions entreprise.
RewriteRule ^event-tech(?:/index\.html|/|\.html)?$ /evenements/corporates/ [R=301,L,NE]

# Un seul domaine indexable : redirection permanente de www vers le domaine canonique.
RewriteCond %{HTTP_HOST} ^www\.myselfiebooth-paris\.fr$ [NC]
RewriteRule ^ https://myselfiebooth-paris.fr%{REQUEST_URI} [R=301,L,NE]

# Compression des ressources texte quand Apache le permet.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Les pages HTML doivent toujours être revalidées afin d'éviter qu'un ancien HTML
# continue de pointer vers des médias remplacés lors d'un nouveau déploiement.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|jpe?g|png|gif|svg|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Cache navigateur adapté aux ressources statiques de l'export Next.js.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
